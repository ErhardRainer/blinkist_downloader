{
  "manifest_version": 3,
  "name": "Blinkist Audio Blob Extractor",
  "version": "1.0.0",
  "description": "Extrahiert blob: Audio-URLs von der aktuellen Seite.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Audio-Blobs extrahieren"
  },
  "content_scripts": [
    {
      "matches": ["https://www.blinkist.com/*", "https://www.blinkist.com.de/*", "<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}